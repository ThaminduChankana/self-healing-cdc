# ─────────────────────────────────────────────────────────────────────────
# Host-side defaults (scripts, tests, `make validator` etc. run on the Mac).
# Containers get their in-network addresses from docker-compose.yml.
# Copy to .env (make setup does this) — .env is git-ignored.
# Demo credentials only; use a secret manager outside local development.
# ─────────────────────────────────────────────────────────────────────────

# Source MySQL (official Debezium example database)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=inventory
# CDC capture user (used by Debezium only)
MYSQL_USER=debezium
MYSQL_PASSWORD=dbz
# only used by the one-shot user bootstrap job
MYSQL_ROOT_PASSWORD=debezium
# read-only inspection
MYSQL_READER_USER=cdc_reader
MYSQL_READER_PASSWORD=cdc_reader_pw
# simulated upstream application (seed data + demo drift)
MYSQL_WRITER_USER=app_writer
MYSQL_WRITER_PASSWORD=app_writer_pw

# Isolated SQL sandbox (AI-proposed migrations run only here)
SANDBOX_DB_HOST=127.0.0.1
SANDBOX_DB_PORT=3307
SANDBOX_DB_USER=sandbox_user
SANDBOX_DB_PASSWORD=sandbox_pass
SANDBOX_DB_ROOT_PASSWORD=sandbox_root

# Redpanda
REDPANDA_BROKERS=localhost:19092
SCHEMA_REGISTRY_URL=http://localhost:18081
DEBEZIUM_CONNECT_URL=http://localhost:8083

# Topics
MUTATIONS_TOPIC=cdc.mutations
VALIDATED_TOPIC=cdc.validated
DLQ_TOPIC=cdc.dlq
REPAIRED_TOPIC=cdc.repaired
AUDIT_TOPIC=cdc.audit

# Local AI (Ollama runs natively on macOS for Apple-silicon acceleration)
# ollama | mock
LLM_MODE=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT_SECONDS=240

# Behaviour
LOG_LEVEL=INFO
AI_REPAIR_ENABLED=true
# AI SQL never leaves the sandbox in the MVP
AUTO_APPLY_SAFE_MIGRATIONS=false
# dlq | validated (pass lossless widening through with a notice)
COMPATIBLE_TYPE_CHANGE_ROUTING=dlq
CONFIDENCE_THRESHOLD=0.90
MAX_AI_RETRIES=3
MAX_CONSUMER_RETRIES=5
SANDBOX_TIMEOUT_SECONDS=5
# host-run processes: 0 = disabled; containers use 8001-8003
METRICS_PORT=0

# Destinations (config/destinations.yaml). Data lake files land in ./lake (LAKE_DIR).
# Comma-separated destination names to run (empty = all enabled)
DOWNSTREAM_ONLY=
# BigQuery destination (needs requirements-optional.txt + Application Default Credentials)
BQ_ENABLED=false
BQ_PROJECT=
BQ_DATASET=cdc
BQ_LOCATION=US
